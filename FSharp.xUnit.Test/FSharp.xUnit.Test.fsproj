<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
<OutputType>Exe</OutputType> 
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="ReflectionTest.fs" />
        <Compile Include="CustomDataExample.fs" />
        <Compile Include="FirstTest.fs" />
        <Compile Include="NaturalAttributeTest.fs" />
        <Compile Include="MemberDataTest.fs" />
        <Compile Include="ParameterizedxUnitTest.fs" />
        <Compile Include="ClassDataBaseTest.fs" />
        <Compile Include="SingleDataSourceTest.fs" />
        <Compile Include="TupleDataSourceTest.fs" />
        <Compile Include="ArrayDataSourceTest.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.400" />
        <PackageReference Include="FSharp.Idioms" Version="1.5.17" />
        <PackageReference Include="xunit.v3.assert" Version="4.0.0" />
        <PackageReference Include="xunit.v3.core.mtp-v2" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FSharp.xUnit\FSharp.xUnit.fsproj" />
    </ItemGroup>

</Project>
